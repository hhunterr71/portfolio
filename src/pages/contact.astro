---
import BaseLayout from '../layouts/BaseLayout.astro';
import NavBar from '../components/NavBar.astro';
import Footer from '../components/Footer.astro';
import ConsultedWith from '../components/hub/ConsultedWith.astro';

const engagementTypes = [
  'Predictive Maintenance & Reliability Modeling',
  'Systems & Equipment Performance Analysis',
  'Data Pipelines & Instrumentation',
  'Dashboards & Data Visualization',
];
---

<BaseLayout title="Contact — Hunter Hamilton" description="Get in touch about an engineering or data consulting engagement.">
  <NavBar current="contact" />

  <main class="max-w-3xl mx-auto px-6 py-16 text-center">
    <p class="text-accent text-xs font-heading uppercase tracking-wide mb-4">Get In Touch</p>
    <h1 class="font-heading font-bold text-3xl mb-4 text-primary">Let's build something.</h1>
    <p class="text-muted mb-10">
      Whether it's a well-scoped project or an open-ended problem you haven't fully framed yet, I'm happy to talk it
      through.
    </p>

    <a
      href="mailto:hunter.j.hamilton1@gmail.com"
      class="inline-block text-sm px-6 py-3 rounded border border-accent text-accent font-heading uppercase tracking-wide hover:bg-accent hover:text-bg transition-colors mb-3"
    >
      Email Me &rarr;
    </a>
    <p class="mb-3">
      <a href="mailto:hunter.j.hamilton1@gmail.com" class="text-primary text-sm hover:text-accent transition-colors">hunter.j.hamilton1@gmail.com</a>
    </p>
    <p class="text-muted text-xs mb-2">
      A few sentences on scope, rough timeline, and budget range help me respond faster.
    </p>
    <p class="text-muted text-xs mb-16">
      I typically reply within 1&ndash;2 business days &middot;{' '}
      <a
        href="https://www.linkedin.com/in/hunter-hamilton1234/"
        target="_blank"
        rel="noopener noreferrer"
        class="text-accent hover:underline"
      >
        or reach out on LinkedIn
      </a>
    </p>

    <div class="border-t border-muted/15 pt-10 mb-2">
      <p class="text-primary font-heading font-bold mb-6">What I help with</p>
      <ul class="flex flex-wrap justify-center gap-3 mb-10">
        {engagementTypes.map((type) => (
          <li class="text-xs px-3 py-1.5 rounded border border-muted/30 text-muted uppercase tracking-wide font-heading">
            {type}
          </li>
        ))}
      </ul>
      <p class="text-muted text-sm">Rates scoped per engagement based on complexity and duration.</p>
    </div>
  </main>

  <ConsultedWith />

  <Footer />
</BaseLayout>
