---
import { getCollection } from 'astro:content';
import { withBase } from '../../lib/url';
import ProjectCard from '../ProjectCard.astro';

const projects = (await getCollection('projects', ({ data }) => data.featured)).sort(
  (a, b) => (a.data.order ?? 99) - (b.data.order ?? 99)
);
---

<section id="selected-projects" class="scroll-mt-24">
  <div class="max-w-5xl mx-auto px-6 py-20">
    <p class="text-accent text-xs font-heading uppercase tracking-wide border-t border-muted/15 pt-4 mb-10">03 &mdash; Selected Projects</p>

    <div class="grid sm:grid-cols-2 gap-4 mb-10">
      {projects.map((project, i) => <ProjectCard project={project} index={i} />)}
    </div>

    <div class="text-center">
      <a
        href={withBase('/projects/')}
        class="inline-block text-sm px-5 py-2.5 rounded border border-accent text-accent font-heading uppercase tracking-wide hover:bg-accent hover:text-bg transition-colors"
      >
        View All Projects &rarr;
      </a>
    </div>
  </div>
</section>
