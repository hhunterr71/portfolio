---
import { withBase } from '../../lib/url';

const steps = [
  {
    title: 'Discovery & Scoping',
    body: 'Understanding the problem space through stakeholder interviews, system mapping, and constraint identification. Every meaningful solution begins with a well-framed problem.',
  },
  {
    title: 'Data Collection & Instrumentation',
    body: 'Identifying critical measurement points and establishing ground truth. Sensor selection, data pipeline design, and signal validation to ensure analysis is built on reliable inputs.',
  },
  {
    title: 'Analysis & Modeling',
    body: 'Root cause analysis, statistical modeling, and data interpretation. Finding the signal in the noise — turning raw measurements into engineering insight.',
  },
  {
    title: 'Synthesis & Insight',
    body: 'Translating technical findings into actionable engineering recommendations. Decision-ready deliverables that bridge the gap between analysis depth and executive clarity.',
  },
  {
    title: 'Implementation & Review',
    body: 'Validating solutions against real-world constraints, iterating on design choices, and documenting outcomes for future reference.',
  },
];
---

<section id="methodology" class="scroll-mt-24">
  <div class="max-w-3xl mx-auto px-6 py-20">
    <p class="text-accent text-xs font-heading uppercase tracking-wide border-t border-muted/15 pt-4 mb-10">02 &mdash; Methodology</p>

    <ol class="space-y-10">
      {steps.map((step, i) => (
        <li class="assemble-in-light relative pl-8" style={`--assemble-delay:${i * 80}ms`}>
          <span class="absolute left-0 top-1.5 w-2 h-2 rounded-full bg-accent"></span>
          {i < steps.length - 1 && <span class="absolute left-[3px] top-4 bottom-[-2.5rem] w-px bg-muted/20"></span>}
          <p class="text-accent text-xs font-heading mb-1">{String(i + 1).padStart(2, '0')}</p>
          <h3 class="font-heading font-bold text-primary mb-2">{step.title}</h3>
          <p class="text-muted text-sm leading-relaxed">{step.body}</p>
        </li>
      ))}
    </ol>

    <div class="assemble-in-light mt-16 pt-10 border-t border-muted/15 text-center" style={`--assemble-delay:${steps.length * 80}ms`}>
      <p class="font-heading font-bold text-lg text-primary mb-2">Have a project like this? Let's talk.</p>
      <p class="text-muted text-sm mb-6">Rates scoped per engagement.</p>
      <a
        href={withBase('/contact/')}
        class="inline-block text-sm px-5 py-2.5 rounded border border-accent text-accent font-heading uppercase tracking-wide hover:bg-accent hover:text-bg transition-colors"
      >
        Contact Me &rarr;
      </a>
    </div>
  </div>
</section>
